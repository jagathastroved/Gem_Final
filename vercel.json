{
    "redirects": [
        {
            "source": "/",
            "destination": "/gemstone-report",
            "permanent": false
        }
    ],
    "rewrites": [
        {
            "source": "/gemstone-report/assets/(.*)",
            "destination": "/assets/$1"
        },
        {
            "source": "/gemstone-report/(.*)",
            "destination": "/index.html"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}